      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sra"
      },
      "description": "Taxa de acerto de cache = acertos / (acertos + buscas). Bloco 3 / E2-T2 (resiliência).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-sra"
          },
          "expr": "rate(sra_cache_hits_total[5m]) / (rate(sra_cache_hits_total[5m]) + sum by () (rate(sra_search_requests_total[5m])))",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latência P95 por modo (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sra"
      },
      "description": "Latência P95 das buscas por fonte (histogram_quantile sobre sra_search_duration_seconds).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-sra"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(sra_search_duration_seconds_bucket[5m])))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Top fontes por erro (últimas 24h)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sra"
      },
      "description": "Contagem de buscas com erro por fonte. Identifica conectores instáveis. Bloco 11 / E7-T2.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-sra"
          },
          "expr": "sum by (source) (increase(sra_search_requests_total{status=\"error\"}[24h]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    }
  ],
