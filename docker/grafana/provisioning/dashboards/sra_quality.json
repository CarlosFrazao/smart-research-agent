      "id": 3,
      "title": "Traceability (cobertura de claim) por modo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sra"
      },
      "description": "Cobertura de rastreabilidade das claims (0-1). Bloco 5 / E1-T1.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlGn"
          },
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
