  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "RAGAS Faithfulness ao longo do tempo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sra"
      },
      "description": "Score de fidelidade do Quality Gate (0-1) por modo de operação (proxy/ragas). Bloco 6 / E1-T2.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-sra"
          },
          "expr": "sra_ragas_faithfulness_score",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "RAGAS Relevancy ao longo do tempo",
      "type": "timeseries",
      "datasource": {
