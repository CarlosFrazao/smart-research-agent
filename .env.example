# ── Provider Principal ────────────────────────────────────────────────────────
# Opções: openrouter | gemini | groq | ollama | anthropic | openai
# Failover automático configurado no LLMClient.
LLM_PROVIDER=gemini

# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── OpenRouter (free tier) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=sua_chave_aqui
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# ── Google Gemini (free tier) ─────────────────────────────────────────────────
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (free tier) ─────────────────────────────────────────────────────────
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# ── Firecrawl (Scraping local ou nuvem) ───────────────────────────────────────
FIRECRAWL_API_KEY=local_bypass
FIRECRAWL_BASE_URL=http://localhost:3022

# ── GitHub (Code/Repo search) ─────────────────────────────────────────────────
GITHUB_TOKEN=seu_github_pat_aqui

# ── Infraestrutura auxiliar via Docker Compose (todas opcionais) ─────────────
# Deixe em branco para usar os defaults dos serviços locais definidos no
# docker-compose.yml (perfis dev/chromadb/neo4j/redis/firecrawl). Se você já
# tem uma stack externa (ex.: SearXNG/Firecrawl compartilhados), sobrescreva
# os valores abaixo apontando para ela.
# SEARXNG_URL=http://searxng:8080
# CHROMADB_HOST=chromadb
# CHROMADB_PORT=8000
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_PASSWORD=password123
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0

# ── Limites e configurações gerais ───────────────────────────────────────────
MAX_RESULTS_PER_SOURCE=15
MAX_ITERATIONS=2
TIMEOUT_PER_SOURCE=30
OUTPUT_DIR=./reports
CACHE_DIR=./.cache
LOG_LEVEL=INFO

# ── HuggingFace Cache ─────────────────────────────────────────────────────────
HF_HOME=./.cache/huggingface
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── FASE 0.1: Searchers Órfãos ───────────────────────────────────────────────────
# Habilita busca multi-idioma (wrapper sobre SearXNG/Web com tradução LLM)
SRA_MULTILINGUAL_ENABLED=false

# Habilita scraping resiliente em cascata (Firecrawl→Spider→Steel→Jina)
SRA_SCRAPING_ENABLED=false

# ── FASE 3A: Novos Searchers (sem API key necessária) ─────────────────────────
# Habilita busca na Wikipedia (API pública)
SRA_WIKIPEDIA_ENABLED=false
WIKI_LANG=en

# Habilita busca DuckDuckGo (API pública)
SRA_DUCKDUCKGO_ENABLED=false

# Habilita busca PyPI (pacotes Python)
SRA_PYPI_ENABLED=false

# ── Segurança da API REST (Auditoria Parte 2 — Fase 3) ─────────────────────────
# Chave de API própria do SRA para proteger os endpoints de pesquisa.
# GERE UM VALOR ALEATÓRIO (ex: `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# e defina aqui. Quando configurada, os endpoints /api/research* exigem o header:
#   X-API-Key: <seu-valor>
# Deixe em branco para DESABILITAR a autenticação (uso local/dev apenas).
SRA_API_KEY=

# Origens permitidas pelo CORS (separadas por vírgula). Em dev local, "*" permite
# qualquer origem. Para produção, restringir às origens reais:
#   CORS_ALLOWED_ORIGINS=https://seu-app.com,https://app.exemplo.com
CORS_ALLOWED_ORIGINS=*

# ── Enterprise Connectors (Notion / Confluence / SharePoint) ─────────────────
# Conectores de fontes corporativas (RAG Enterprise). Todos OPCIONAIS: se ausentes,
# o SearcherFactory simplesmente não registra a fonte (ela é primária/secundária em
# 5 de 7 domínios, mas fica silenciosamente desativada sem credenciais).
#
# Notion — Integration Token (permissão de leitura):
NOTION_API_KEY=

# Confluence (Atlassian) — autenticação Basic Auth com username:api_token.
# O api_key abaixo é o "API token" (NÃO a senha). O username é o email Atlassian.
CONFLUENCE_API_KEY=
CONFLUENCE_BASE_URL=https://sua-empresa.atlassian.net
CONFLUENCE_USERNAME=voce@empresa.com

# SharePoint (Microsoft Graph) — App Registration Azure AD (client credentials flow).
# Escopo necessário: Sites.Read.All, Files.Read.All
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=
